# --- Legacy source (already provided in the repo-root .env) ---
# LEGACY_SQL_SERVER_ADDRESS=...
# LEGACY_SQL_SERVER_DATABASE=...
# LEGACY_SQL_SERVER_PORT=1433
# LEGACY_SQL_SERVER_USERNAME=...
# LEGACY_SQL_SERVER_PASSWORD=...

# --- Target (you provide this) ---
# Supabase DIRECT connection string (Project Settings -> Database -> Connection string -> URI).
# Use the direct/session connection (port 5432) for the spike, NOT the pooler.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# --- Optional ---
# Pin a specific set instead of auto-picking the smallest non-empty one:
# SPIKE_SET_ID=1234
# Schema name to use as the isolated sandbox (default: spike):
# SPIKE_SCHEMA=spike
