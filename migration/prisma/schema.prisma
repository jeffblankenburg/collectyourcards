generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["legacy"]
}

model achievement_categories {
  category_id                                                   BigInt               @id @default(autoincrement())
  name                                                          String               @db.VarChar(100)
  description                                                   String?              @db.VarChar(500)
  icon                                                          String?              @db.VarChar(255)
  display_order                                                 Int?
  is_active                                                     Boolean?
  created_at                                                    DateTime             @db.Timestamptz(6)
  updated_at                                                    DateTime?            @db.Timestamptz(6)
  achievement_series                                            achievement_series[]
  achievements_achievements_categoryToachievement_categories    achievements[]       @relation("achievements_categoryToachievement_categories")
  achievements_achievements_category_idToachievement_categories achievements[]       @relation("achievements_category_idToachievement_categories")

  @@schema("legacy")
}

model achievement_challenges {
  challenge_id                                  BigInt       @id @default(autoincrement())
  user_id                                       BigInt
  achievement_id                                BigInt
  challenge_type                                String?      @db.VarChar(50)
  challenge_reason                              String?      @db.VarChar(500)
  status                                        String?      @db.VarChar(50)
  created_at                                    DateTime     @db.Timestamptz(6)
  resolved_at                                   DateTime?    @db.Timestamptz(6)
  resolved_by                                   BigInt?
  resolution_notes                              String?      @db.VarChar(500)
  achievements                                  achievements @relation(fields: [achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__achie__2724C5F0")
  user_achievement_challenges_resolved_byTouser user?        @relation("achievement_challenges_resolved_byTouser", fields: [resolved_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__resol__2A01329B")
  user_achievement_challenges_user_idTouser     user         @relation("achievement_challenges_user_idTouser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__user___2630A1B7")

  @@schema("legacy")
}

model achievement_dependencies {
  dependency_id                                                               BigInt       @id @default(autoincrement())
  achievement_id                                                              BigInt
  required_achievement_id                                                     BigInt
  achievements_achievement_dependencies_achievement_idToachievements          achievements @relation("achievement_dependencies_achievement_idToachievements", fields: [achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__achie__2DD1C37F")
  achievements_achievement_dependencies_required_achievement_idToachievements achievements @relation("achievement_dependencies_required_achievement_idToachievements", fields: [required_achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__requi__2EC5E7B8")

  @@schema("legacy")
}

model achievement_history {
  history_id        BigInt       @id @default(autoincrement())
  user_id           BigInt
  achievement_id    BigInt
  action            String?      @db.VarChar(50)
  previous_progress Int?
  new_progress      Int?
  points_change     Int?
  trigger_event     String?      @db.VarChar(100)
  created_at        DateTime     @db.Timestamptz(6)
  achievements      achievements @relation(fields: [achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__achie__131DCD43")
  user              user         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__user___1229A90A")

  @@schema("legacy")
}

model achievement_notifications {
  notification_id   BigInt        @id @default(autoincrement())
  user_id           BigInt
  achievement_id    BigInt?
  notification_type String?       @db.VarChar(50)
  title             String?       @db.VarChar(200)
  message           String?       @db.VarChar(500)
  icon_url          String?       @db.VarChar(500)
  points_awarded    Int?
  is_sent           Boolean?
  is_read           Boolean?
  created_at        DateTime      @db.Timestamptz(6)
  sent_at           DateTime?     @db.Timestamptz(6)
  read_at           DateTime?     @db.Timestamptz(6)
  achievements      achievements? @relation(fields: [achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__achie__2077C861")
  user              user          @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__user___1F83A428")

  @@schema("legacy")
}

model achievement_series {
  series_id                  BigInt                       @id @default(autoincrement())
  series_name                String                       @db.VarChar(200)
  description                String?                      @db.VarChar(500)
  category_id                BigInt?
  total_points               Int?
  created_at                 DateTime                     @db.Timestamptz(6)
  achievement_categories     achievement_categories?      @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__categ__7775B2CE")
  achievement_series_members achievement_series_members[]

  @@schema("legacy")
}

model achievement_series_members {
  member_id          BigInt             @id @default(autoincrement())
  series_id          BigInt
  achievement_id     BigInt
  series_order       Int?
  achievements       achievements       @relation(fields: [achievement_id], references: [achievement_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__achie__7E22B05D")
  achievement_series achievement_series @relation(fields: [series_id], references: [series_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__serie__7D2E8C24")

  @@schema("legacy")
}

model achievements {
  achievement_id                                                                          BigInt                       @id @default(autoincrement())
  category                                                                                BigInt?
  subcategory                                                                             String?                      @db.VarChar(100)
  name                                                                                    String                       @db.VarChar(200)
  description                                                                             String                       @db.VarChar(500)
  points                                                                                  Int
  tier                                                                                    String?                      @db.VarChar(20)
  icon_url                                                                                String?                      @db.VarChar(500)
  requirement_type                                                                        String?                      @db.VarChar(50)
  requirement_value                                                                       Int?
  requirement_query                                                                       String?
  completion_query                                                                        String?
  is_active                                                                               Boolean?
  is_secret                                                                               Boolean?
  is_repeatable                                                                           Boolean?
  cooldown_days                                                                           Int?
  created_at                                                                              DateTime                     @db.Timestamptz(6)
  updated_at                                                                              DateTime?                    @db.Timestamptz(6)
  category_id                                                                             BigInt?
  achievement_challenges                                                                  achievement_challenges[]
  achievement_dependencies_achievement_dependencies_achievement_idToachievements          achievement_dependencies[]   @relation("achievement_dependencies_achievement_idToachievements")
  achievement_dependencies_achievement_dependencies_required_achievement_idToachievements achievement_dependencies[]   @relation("achievement_dependencies_required_achievement_idToachievements")
  achievement_history                                                                     achievement_history[]
  achievement_notifications                                                               achievement_notifications[]
  achievement_series_members                                                              achievement_series_members[]
  achievement_categories_achievements_categoryToachievement_categories                    achievement_categories?      @relation("achievements_categoryToachievement_categories", fields: [category], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__achieveme__categ__6462DE5A")
  achievement_categories_achievements_category_idToachievement_categories                 achievement_categories?      @relation("achievements_category_idToachievement_categories", fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_achievements_category")
  user_achievements                                                                       user_achievements[]

  @@schema("legacy")
}

model admin_action_log {
  log_id      BigInt   @id @default(autoincrement())
  user_id     BigInt
  action_type String   @db.VarChar(50)
  entity_type String   @db.VarChar(50)
  entity_id   String?  @db.VarChar(100)
  old_values  String?
  new_values  String?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(500)
  created     DateTime @db.Timestamptz(6)
  user        user     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__admin_act__user___24B26D99")

  @@schema("legacy")
}

model admin_set_view {
  admin_set_view_id BigInt   @id @default(autoincrement())
  user_id           BigInt
  set_id            Int
  last_viewed       DateTime @db.Timestamptz(6)
  view_count        Int
  set               set      @relation(fields: [set_id], references: [set_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_set_view_set")
  user              user     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_admin_set_view_user")

  @@schema("legacy")
}

model card {
  card_id                                                 BigInt                  @id @default(autoincrement())
  sort_order                                              Int?
  card_number                                             String?
  is_rookie                                               Boolean
  is_autograph                                            Boolean
  is_relic                                                Boolean
  print_run                                               Int?
  series                                                  BigInt?
  color                                                   Int?
  notes                                                   String?
  created                                                 DateTime                @db.Timestamptz(6)
  created_month                                           DateTime?               @db.Date
  card_number_indexed                                     String?                 @db.VarChar(100)
  reference_user_card                                     BigInt?
  is_short_print                                          Boolean
  front_image_path                                        String?
  back_image_path                                         String?
  color_card_colorTocolor                                 color?                  @relation("card_colorTocolor", fields: [color], references: [color_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_color")
  user_card_card_reference_user_cardTouser_card           user_card?              @relation("card_reference_user_cardTouser_card", fields: [reference_user_card], references: [user_card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_reference_user_card")
  card_edit_submissions                                   card_edit_submissions[]
  card_external_id                                        card_external_id[]
  card_player_team_card_player_team_cardTocard            card_player_team[]      @relation("card_player_team_cardTocard")
  card_price                                              card_price[]
  card_submissions                                        card_submissions[]
  card_variation_card_variation_cardTocard                card_variation[]        @relation("card_variation_cardTocard")
  duplicate_detection_duplicate_detection_card_id_1Tocard duplicate_detection[]   @relation("duplicate_detection_card_id_1Tocard")
  duplicate_detection_duplicate_detection_card_id_2Tocard duplicate_detection[]   @relation("duplicate_detection_card_id_2Tocard")
  ebay_purchase                                           ebay_purchase[]
  player                                                  player[]
  sale                                                    sale[]
  user_card_user_card_cardTocard                          user_card[]             @relation("user_card_cardTocard")

  @@schema("legacy")
}

model card_edit_submissions {
  submission_id                                BigInt    @id @default(autoincrement())
  card_id                                      BigInt
  user_id                                      BigInt
  proposed_card_number                         String?
  proposed_is_rookie                           Boolean?
  proposed_is_autograph                        Boolean?
  proposed_is_relic                            Boolean?
  proposed_is_short_print                      Boolean?
  proposed_print_run                           Int?
  proposed_notes                               String?
  submission_notes                             String?
  status                                       String    @db.VarChar(20)
  reviewed_by                                  BigInt?
  reviewed_at                                  DateTime? @db.Timestamptz(6)
  review_notes                                 String?
  created_at                                   DateTime  @db.Timestamptz(6)
  updated_at                                   DateTime? @db.Timestamptz(6)
  previous_card_number                         String?
  previous_is_rookie                           Boolean?
  previous_is_autograph                        Boolean?
  previous_is_relic                            Boolean?
  previous_is_short_print                      Boolean?
  previous_print_run                           Int?
  previous_notes                               String?
  batch_id                                     String?   @db.VarChar(100)
  card                                         card      @relation(fields: [card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_edit_submissions_card")
  user_card_edit_submissions_reviewed_byTouser user?     @relation("card_edit_submissions_reviewed_byTouser", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_edit_submissions_reviewer")
  user_card_edit_submissions_user_idTouser     user      @relation("card_edit_submissions_user_idTouser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_edit_submissions_user")

  @@schema("legacy")
}

model card_external_id {
  card_external_id_id BigInt       @id @default(autoincrement())
  card_id             BigInt
  price_source_id     Int
  external_id         String       @db.VarChar(100)
  external_name       String?      @db.VarChar(500)
  match_method        String       @db.VarChar(20)
  created_at          DateTime     @db.Timestamptz(6)
  updated_at          DateTime?    @db.Timestamptz(6)
  card                card         @relation(fields: [card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_external_id_card")
  price_source        price_source @relation(fields: [price_source_id], references: [price_source_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_external_id_source")

  @@schema("legacy")
}

model card_player_team {
  card_player_team_id                                   BigInt       @id @default(autoincrement())
  card                                                  BigInt?
  player_team                                           BigInt?
  created                                               DateTime     @db.Timestamptz(6)
  card_card_player_team_cardTocard                      card?        @relation("card_player_team_cardTocard", fields: [card], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_player_team_card")
  player_team_card_player_team_player_teamToplayer_team player_team? @relation("card_player_team_player_teamToplayer_team", fields: [player_team], references: [player_team_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_player_team_player_team")

  @@schema("legacy")
}

model card_price {
  card_price_id   BigInt       @id @default(autoincrement())
  card_id         BigInt
  price_type_id   Int
  price_source_id Int
  price           Decimal?     @db.Decimal(10, 2)
  last_updated    DateTime     @db.Timestamptz(6)
  card            card         @relation(fields: [card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_price_card")
  price_source    price_source @relation(fields: [price_source_id], references: [price_source_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_price_source")
  price_type      price_type   @relation(fields: [price_type_id], references: [price_type_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_price_type")

  @@schema("legacy")
}

model card_submissions {
  submission_id                           BigInt              @id @default(autoincrement())
  user_id                                 BigInt
  series_id                               BigInt?
  series_submission_id                    BigInt?
  batch_id                                String?             @db.VarChar(50)
  batch_sequence                          Int?
  proposed_card_number                    String              @db.VarChar(50)
  proposed_player_names                   String?             @db.VarChar(500)
  proposed_team_names                     String?             @db.VarChar(500)
  proposed_is_rookie                      Boolean
  proposed_is_autograph                   Boolean
  proposed_is_relic                       Boolean
  proposed_is_short_print                 Boolean
  proposed_print_run                      Int?
  proposed_notes                          String?
  matched_player_ids                      String?             @db.VarChar(200)
  matched_team_ids                        String?             @db.VarChar(200)
  submission_notes                        String?
  status                                  String              @db.VarChar(20)
  created_card_id                         BigInt?
  reviewed_by                             BigInt?
  reviewed_at                             DateTime?           @db.Timestamptz(6)
  review_notes                            String?
  created_at                              DateTime            @db.Timestamptz(6)
  updated_at                              DateTime?           @db.Timestamptz(6)
  proposed_color                          String?             @db.VarChar(100)
  card                                    card?               @relation(fields: [created_card_id], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_submissions_created_card")
  user_card_submissions_reviewed_byTouser user?               @relation("card_submissions_reviewed_byTouser", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_submissions_reviewer")
  series                                  series?             @relation(fields: [series_id], references: [series_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_submissions_series")
  series_submissions                      series_submissions? @relation(fields: [series_submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_submissions_series_submission")
  user_card_submissions_user_idTouser     user                @relation("card_submissions_user_idTouser", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_submissions_user")

  @@schema("legacy")
}

model card_variation {
  card_variation_id                                  BigInt      @id @default(autoincrement())
  card                                               BigInt?
  description                                        String?
  created                                            DateTime?   @db.Timestamptz(6)
  card_card_variation_cardTocard                     card?       @relation("card_variation_cardTocard", fields: [card], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_card_variation_card")
  user_card_user_card_card_variationTocard_variation user_card[] @relation("user_card_card_variationTocard_variation")

  @@schema("legacy")
}

model collection_view {
  collection_view_id              BigInt    @id @default(autoincrement())
  user                            BigInt
  name                            String    @db.VarChar(255)
  slug                            String    @db.VarChar(255)
  description                     String?
  filter_config                   String
  is_public                       Boolean?
  view_count                      Int?
  created_at                      DateTime? @db.Timestamptz(6)
  updated_at                      DateTime? @db.Timestamptz(6)
  user_collection_view_userTouser user      @relation("collection_view_userTouser", fields: [user], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_collection_view_user")

  @@schema("legacy")
}

model color {
  color_id                   Int      @id @default(autoincrement())
  name                       String?
  hex_value                  String?
  created                    DateTime @db.Timestamptz(6)
  name_indexed               String?  @db.VarChar(100)
  card_card_colorTocolor     card[]   @relation("card_colorTocolor")
  series_series_colorTocolor series[] @relation("series_colorTocolor")

  @@schema("legacy")
}

model content_reports {
  report_id                                   BigInt             @id @default(autoincrement())
  reporter_user_id                            BigInt
  comment_id                                  BigInt
  report_reason                               String             @db.VarChar(50)
  report_details                              String?            @db.VarChar(1000)
  status                                      String             @db.VarChar(20)
  reviewed_by                                 BigInt?
  reviewed_at                                 DateTime?          @db.Timestamptz(6)
  created_at                                  DateTime           @db.Timestamptz(6)
  universal_comments                          universal_comments @relation(fields: [comment_id], references: [comment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_content_reports_comment")
  user_content_reports_reporter_user_idTouser user               @relation("content_reports_reporter_user_idTouser", fields: [reporter_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_content_reports_reporter")
  user_content_reports_reviewed_byTouser      user?              @relation("content_reports_reviewed_byTouser", fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_content_reports_reviewer")

  @@schema("legacy")
}

model contributor_stats {
  user_id                 BigInt    @id
  total_submissions       Int
  pending_submissions     Int
  approved_submissions    Int
  rejected_submissions    Int
  approval_rate           Decimal?  @db.Decimal(5, 2)
  trust_level             String    @db.VarChar(20)
  trust_points            Int
  first_submission_at     DateTime? @db.Timestamptz(6)
  last_submission_at      DateTime? @db.Timestamptz(6)
  current_streak_days     Int
  longest_streak_days     Int
  created_at              DateTime  @db.Timestamptz(6)
  updated_at              DateTime? @db.Timestamptz(6)
  set_submissions         Int
  series_submissions      Int
  card_submissions        Int
  player_edit_submissions Int
  team_edit_submissions   Int
  user                    user      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_contributor_stats_user")

  @@schema("legacy")
}

model duplicate_detection {
  detection_id                             BigInt    @id @default(autoincrement())
  card_id_1                                BigInt
  card_id_2                                BigInt
  similarity_score                         Decimal?  @db.Decimal(5, 4)
  status                                   String?   @db.VarChar(50)
  reviewed_by                              BigInt?
  reviewed_at                              DateTime? @db.Timestamptz(6)
  created_at                               DateTime? @db.Timestamptz(6)
  card_duplicate_detection_card_id_1Tocard card      @relation("duplicate_detection_card_id_1Tocard", fields: [card_id_1], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__duplicate__card___031C6FA4")
  card_duplicate_detection_card_id_2Tocard card      @relation("duplicate_detection_card_id_2Tocard", fields: [card_id_2], references: [card_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__duplicate__card___041093DD")
  user                                     user?     @relation(fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__duplicate__revie__0504B816")

  @@schema("legacy")
}

model duplicate_detection_job {
  job_id                BigInt    @id @default(autoincrement())
  started_at            DateTime  @db.Timestamptz(6)
  completed_at          DateTime? @db.Timestamptz(6)
  status                String    @db.VarChar(50)
  total_players_checked Int
  groups_found          Int
  error_message         String?

  @@schema("legacy")
}

model duplicate_exclusion {
  player1_id                                    BigInt
  player2_id                                    BigInt
  created                                       DateTime? @db.Timestamptz(6)
  created_by                                    BigInt?
  player_duplicate_exclusion_player1_idToplayer player    @relation("duplicate_exclusion_player1_idToplayer", fields: [player1_id], references: [player_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_duplicate_exclusion_player1")
  player_duplicate_exclusion_player2_idToplayer player    @relation("duplicate_exclusion_player2_idToplayer", fields: [player2_id], references: [player_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_duplicate_exclusion_player2")
  user                                          user?     @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_duplicate_exclusion_user")

  @@id([player1_id, player2_id])
  @@schema("legacy")
}

model duplicate_player_group {
  group_id                BigInt                    @id @default(autoincrement())
  similarity_score        Float
  total_cards             Int
  status                  String                    @db.VarChar(50)
  created                 DateTime                  @db.Timestamptz(6)
  last_updated            DateTime                  @db.Timestamptz(6)
  resolved_by_user_id     BigInt?
  resolved_at             DateTime?                 @db.Timestamptz(6)
  user                    user?                     @relation(fields: [resolved_by_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_duplicate_player_group_user")
  duplicate_player_member duplicate_player_member[]

  @@schema("legacy")
}

model duplicate_player_member {
  member_id              BigInt                 @id @default(autoincrement())
  group_id               BigInt
  player_id              BigInt
  is_primary             Boolean
  created                DateTime               @db.Timestamptz(6)
